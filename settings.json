    "workflows": {
      "intelligent-coding-session": {
        "name": "Intelligent Coding Workflow (GPT-5 style)",
        "description": "Multi-model collaboration for high-quality code generation like GPT-4/5",
        "models": [
          "qwen2.5-coder-7b-instruct",
          "deepseek-coder-v2-lite-instruct",
          "text-embedding-nomic-embed-text-v1.5"
        ],
        "flow": [
          {
            "step": 1,
            "model": "text-embedding-nomic-embed-text-v1.5",
            "role": "context-researcher",
            "prompt_template": "Analyze codebase context: {{code}}. Find similar patterns and relevant examples.",
            "deliverable": "contextual_insights"
          },
          {
            "step": 2,
            "model": "qwen2.5-coder-7b-instruct",
            "role": "code-generator",
            "prompt_template": "Generate code for: {{task}}. Context: {{contextual_insights}}. Use best practices.",
            "deliverable": "initial_code"
          },
          {
            "step": 3,
            "model": "deepseek-coder-v2-lite-instruct",
            "role": "code-reviewer",
            "prompt_template": "Review this code for errors, optimization, and best practices: {{initial_code}}",
            "deliverable": "reviewed_code"
          }
        ]
      },
      "rapid-debugging": {
        "name": "Rapid Debugging Workflow",
        "description": "Fast debugging with multiple perspectives",
        "models": [
          "deepseek-coder-v2-lite-instruct",
          "qwen2.5-coder-7b-instruct"
        ],
        "flow": [
          {
            "step": 1,
            "model": "deepseek-coder-v2-lite-instruct",
            "role": "error-analyzer",
            "prompt_template": "Analyze this error: {{error}}. Code: {{code}}. Root cause:",
            "deliverable": "diagnosis"
          },
          {
            "step": 2,
            "model": "qwen2.5-coder-7b-instruct",
            "role": "fix-generator",
            "prompt_template": "Generate fix based on diagnosis: {{diagnosis}}",
            "deliverable": "fix"
          }
        ]
      },
      "gpt5-equivalent-coding": {
        "name": "GPT-5 Equivalent Coding Session",
        "description": "Comprehensive coding with full context and quality assurance",
        "models": [
          "qwen2.5-coder-7b-instruct",
          "deepseek-coder-v2-lite-instruct",
          "text-embedding-nomic-embed-text-v1.5"
        ],
        "flow": [
          {
            "step": 1,
            "model": "text-embedding-nomic-embed-text-v1.5",
            "role": "semantic-understanding",
            "prompt_template": "Understand context and find relevant patterns for: {{task}}",
            "deliverable": "semantic_context"
          },
          {
            "step": 2,
            "model": "qwen2.5-coder-7b-instruct",
            "role": "primary-coder",
            "prompt_template": "Write high-quality, production-ready code for: {{task}}. Context: {{semantic_context}}. Requirements: {{requirements}}",
            "deliverable": "production_code"
          },
          {
            "step": 3,
            "model": "deepseek-coder-v2-lite-instruct",
            "role": "quality-assurance",
            "prompt_template": "Review for: bugs, security, performance, best practices. Code: {{production_code}}",
            "deliverable": "certified_code"
          }
        ]
      }
