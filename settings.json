    "workflows": {
      "coding-session": {
        "name": "Complete Coding Workflow",
        "description": "Generate, debug, and optimize code",
        "models": [
          "qwen2.5-coder-14b-instruct-mlx",
          "qwen2.5-coder-7b-instruct-mlx",
          "deepseek-coder-v2-lite-instruct-mlx"
        ],
        "flow": [
          {
            "step": 1,
            "model": "qwen2.5-coder-14b-instruct-mlx",
            "role": "code-generator",
            "prompt_template": "Generate comprehensive code for: {{task}}",
            "deliverable": "initial_implementation"
          },
          {
            "step": 2,
            "model": "deepseek-coder-v2-lite-instruct-mlx",
            "role": "code-reviewer",
            "prompt_template": "Review and optimize this code: {{code}}",
            "deliverable": "optimized_implementation"
          }
        ]
      },
      "debugging-session": {
        "name": "Debugging Workflow",
        "description": "Analyze and fix code errors",
        "models": [
          "deepseek-coder-v2-lite-instruct-mlx",
          "qwen2.5-coder-7b-instruct-mlx",
          "qwen2.5-coder-14b-instruct-mlx"
        ],
        "flow": [
          {
            "step": 1,
            "model": "deepseek-coder-v2-lite-instruct-mlx",
            "role": "error-analyzer",
            "prompt_template": "Analyze this error: {{error}}. Code context: {{code}}",
            "deliverable": "error_diagnosis"
          },
          {
            "step": 2,
            "model": "qwen2.5-coder-14b-instruct-mlx",
            "role": "fix-generator",
            "prompt_template": "Generate a fix based on: {{diagnosis}}",
            "deliverable": "fixed_code"
          }
        ]
      },
      "ideation-session": {
        "name": "Creative Ideation Workflow",
        "description": "Generate ideas and explore solutions",
        "models": [
          "qwen2.5-coder-14b-instruct-mlx"
        ],
        "flow": [
          {
            "step": 1,
            "model": "qwen2.5-coder-14b-instruct-mlx",
            "role": "ideation-generator",
            "prompt_template": "Brainstorm creative solutions for: {{problem}}",
            "deliverable": "idea_list"
          }
        ]
      },
      "testing-session": {
        "name": "Testing Workflow",
        "description": "Generate tests for existing code",
        "models": [
          "deepseek-coder-v2-lite-instruct-mlx",
          "qwen2.5-coder-7b-instruct-mlx",
          "qwen2.5-coder-14b-instruct-mlx"
        ],
        "flow": [
          {
            "step": 1,
            "model": "deepseek-coder-v2-lite-instruct-mlx",
            "role": "test-analyzer",
            "prompt_template": "Analyze this code for test coverage: {{code}}",
            "deliverable": "test_plan"
          },
          {
            "step": 2,
            "model": "qwen2.5-coder-14b-instruct-mlx",
            "role": "test-generator",
            "prompt_template": "Generate tests based on: {{test_plan}}",
            "deliverable": "test_suite"
          }
        ]
      }
    },
    "integrations": {
      "embedding": {
        "model": "text-embedding-nomic-embed-text-v1.5",
        "use_cases": [
          "semantic-code-search",
          "document-retrieval",
          "similarity-matching",
          "context-building"
        ],
        "workflow": "Use embeddings to find similar code, understand context, and provide better code suggestions"
      }
    },
    "system_prompts": {
      "coding": "Je bent een expert developer gespecialiseerd in moderne software ontwikkeling. Help met code generatie, debugging en optimalisatie.",
      "debugging": "Je bent een expert in debugging. Analyseer fouten grondig en geef duidelijke oplossingen.",
      "ideation": "Je bent een creatief denker. Genereer innovatieve ideeën en oplossingen voor complexe problemen.",
      "testing": "Je bent een test expert. Creëer uitgebreide test suites die alle edge cases coveren."
