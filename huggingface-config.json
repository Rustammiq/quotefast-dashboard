{
  "huggingface": {
    "server": {
      "host": "localhost",
      "port": 1234,
      "endpoint": "http://localhost:1234/v1"
    },
    "models": {
      "deepseek-coder-v2-lite-instruct-mlx": {
        "name": "deepseek-coder-v2-lite-instruct-mlx",
        "description": "Lightweight DeepSeek coder model for efficient code generation and debugging",
        "parameters": {
          "temperature": 0.3,
          "max_tokens": 2048,
          "top_p": 0.9,
          "frequency_penalty": 0.1,
          "presence_penalty": 0.1,
          "stop": ["```", "\n\n\n", "</code>"]
        },
        "specialties": [
          "code-generation",
          "debugging",
          "refactoring",
          "code-review"
        ]
      },
      "qwen2.5-coder-14b-instruct-mlx": {
        "name": "qwen2.5-coder-14b-instruct-mlx",
        "description": "Advanced Qwen coder model for complex coding tasks and architecture design",
        "parameters": {
          "temperature": 0.4,
          "max_tokens": 4096,
          "top_p": 0.95,
          "frequency_penalty": 0.0,
          "presence_penalty": 0.0,
          "stop": ["```", "\n\n\n", "</code>"]
        },
        "specialties": [
          "architecture-design",
          "complex-algorithms",
          "system-design",
          "performance-optimization"
        ]
      },
      "mradermacher/nanonets-ocr2-3b": {
        "name": "mradermacher/nanonets-ocr2-3b",
        "description": "High-accuracy OCR model for document text extraction and processing",
        "parameters": {
          "temperature": 0.1,
          "max_tokens": 1024,
          "top_p": 0.8,
          "frequency_penalty": 0.0,
          "presence_penalty": 0.0,
          "stop": ["\n\n\n"]
        },
        "specialties": [
          "document-ocr",
          "text-extraction",
          "invoice-processing",
          "receipt-scanning"
        ]
      },
      "mlx-community/nanonets-ocr2-3b": {
        "name": "mlx-community/nanonets-ocr2-3b",
        "description": "Optimized OCR model for fast document processing",
        "parameters": {
          "temperature": 0.1,
          "max_tokens": 1024,
          "top_p": 0.8,
          "frequency_penalty": 0.0,
          "presence_penalty": 0.0,
          "stop": ["\n\n\n"]
        },
        "specialties": [
          "fast-ocr",
          "document-processing",
          "text-extraction"
        ]
      },
      "qwen/qwen3-vl-4b": {
        "name": "qwen/qwen3-vl-4b",
        "description": "Vision-Language model for multimodal understanding",
        "parameters": {
          "temperature": 0.2,
          "max_tokens": 2048,
          "top_p": 0.9,
          "frequency_penalty": 0.0,
          "presence_penalty": 0.0,
          "stop": ["\n\n\n"]
        },
        "specialties": [
          "vision-language",
          "image-understanding",
          "visual-question-answering",
          "multimodal-analysis"
        ]
      }
    },
    "collaboration": {
      "enabled": true,
      "workflows": {
        "coding-session": {
          "models": ["deepseek-coder-v2-lite-instruct-mlx", "qwen2.5-coder-14b-instruct-mlx"],
          "flow": [
            {
              "model": "qwen2.5-coder-14b-instruct-mlx",
              "role": "analyzer",
              "prompt": "Let's analyze and design the solution..."
            },
            {
              "model": "deepseek-coder-v2-lite-instruct-mlx", 
              "role": "implementer",
              "prompt": "Based on the design, let's implement the solution..."
            }
          ]
        }
      }
    }
  }
}
